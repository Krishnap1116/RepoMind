# Copy to .env and fill in your key: cp .env.example .env

# OpenAI (what the README results were measured with). Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
OPENAI_API_BASE=https://api.openai.com/v1
GEN_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4o-mini

# To use OpenRouter instead (https://openrouter.ai/keys), replace the four lines above with:
# OPENAI_API_KEY=your-openrouter-key-here
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# GEN_MODEL=openai/gpt-4.1-mini
# JUDGE_MODEL=openai/gpt-4o-mini

# Optional: these run locally and need no key (defaults shown)
# EMBED_MODEL=local:BAAI/bge-base-en-v1.5
# RERANK_MODEL=BAAI/bge-reranker-base
